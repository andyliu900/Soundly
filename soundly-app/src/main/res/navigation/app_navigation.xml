<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_navigation"
    app:startDestination="@id/startupFragment">

    <fragment
        android:id="@+id/startupFragment"
        android:name="com.ideacode.soundly.feature.startup.StartupFragment"
        android:label="@string/app_name" />
    <fragment android:id="@+id/onboardingFragment"
        android:name="com.ideacode.soundly.feature.onboarding.OnboardingFragment"
        android:label="@string/app_name" />
    <fragment android:id="@+id/homeFragment"
        android:name="com.ideacode.soundly.feature.home.HomeFragment"
        android:label="@string/app_name" />
    <fragment android:id="@+id/settingsFragment"
        android:name="com.ideacode.soundly.feature.settings.SettingsFragment"
        android:label="@string/settings_title" />
    <fragment android:id="@+id/recordingSettingsFragment"
        android:name="com.ideacode.soundly.feature.settings.RecordingSettingsFragment"
        android:label="@string/recording_settings_title" />
    <fragment android:id="@+id/outputSettingsFragment"
        android:name="com.ideacode.soundly.feature.settings.OutputSettingsFragment"
        android:label="@string/output_settings_title" />
    <fragment android:id="@+id/storageManagementFragment"
        android:name="com.ideacode.soundly.feature.settings.StorageManagementFragment"
        android:label="@string/storage_management_title" />
    <fragment android:id="@+id/privacyFragment"
        android:name="com.ideacode.soundly.feature.settings.PrivacyFragment"
        android:label="@string/privacy_title" />
    <fragment android:id="@+id/helpFeedbackFragment"
        android:name="com.ideacode.soundly.feature.settings.HelpFeedbackFragment"
        android:label="@string/help_feedback_title" />
    <fragment android:id="@+id/proFragment"
        android:name="com.ideacode.soundly.feature.settings.ProFragment"
        android:label="@string/pro_title" />
    <fragment android:id="@+id/libraryFragment"
        android:name="com.ideacode.soundly.feature.library.LibraryFragment"
        android:label="@string/library_title" />
    <fragment android:id="@+id/projectDetailFragment"
        android:name="com.ideacode.soundly.feature.project.ProjectDetailFragment"
        android:label="@string/project_detail_title">
        <argument android:name="projectId" app:argType="string" />
    </fragment>
    <fragment android:id="@+id/recoveryFragment"
        android:name="com.ideacode.soundly.feature.startup.RecoveryFragment"
        android:label="@string/recover_title">
        <argument android:name="sessionId" app:argType="string" />
    </fragment>
    <fragment android:id="@+id/prepareRecordingFragment"
        android:name="com.ideacode.soundly.feature.recording.PrepareRecordingFragment"
        android:label="@string/prepare_recording_title" />
    <fragment android:id="@+id/recordingFragment"
        android:name="com.ideacode.soundly.feature.recording.RecordingFragment"
        android:label="@string/recording_title" />
    <fragment android:id="@+id/audioPreviewFragment"
        android:name="com.ideacode.soundly.feature.preview.AudioPreviewFragment"
        android:label="@string/preview_title">
        <argument android:name="projectId" app:argType="string" />
        <argument android:name="variantId" app:argType="string" android:defaultValue="" />
    </fragment>
    <fragment android:id="@+id/trimFragment"
        android:name="com.ideacode.soundly.feature.editing.TrimFragment"
        android:label="@string/trim_title">
        <argument android:name="projectId" app:argType="string" />
        <argument android:name="variantId" app:argType="string" />
        <argument android:name="durationMs" app:argType="long" />
    </fragment>
    <fragment android:id="@+id/enhancementSetupFragment"
        android:name="com.ideacode.soundly.feature.enhancement.EnhancementSetupFragment"
        android:label="@string/enhancement_title">
        <argument android:name="projectId" app:argType="string" />
        <argument android:name="variantId" app:argType="string" />
    </fragment>
    <fragment android:id="@+id/enhancementProgressFragment"
        android:name="com.ideacode.soundly.feature.enhancement.EnhancementProgressFragment"
        android:label="@string/enhancement_progress_title">
        <argument android:name="taskId" app:argType="string" />
    </fragment>
    <fragment android:id="@+id/enhancementResultFragment"
        android:name="com.ideacode.soundly.feature.enhancement.EnhancementResultFragment"
        android:label="@string/enhancement_result_title">
        <argument android:name="projectId" app:argType="string" />
        <argument android:name="originalVariantId" app:argType="string" />
        <argument android:name="enhancedVariantId" app:argType="string" />
    </fragment>
    <fragment android:id="@+id/exportFragment"
        android:name="com.ideacode.soundly.feature.export.ExportFragment"
        android:label="@string/export_title">
        <argument android:name="projectId" app:argType="string" />
        <argument android:name="variantId" app:argType="string" />
    </fragment>
</navigation>
