<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/player_toggle" style="@style/Widget.Material3.Button.IconButton.Filled" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:contentDescription="@string/preview_play" app:icon="@drawable/ic_h4_play" app:iconSize="24dp" app:iconPadding="0dp" app:iconGravity="textStart" app:iconTint="@color/white" app:cornerRadius="24dp" />
        <com.google.android.material.textview.MaterialTextView android:id="@+id/player_position" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/enhancement_progress_secondary" android:textSize="13sp" android:textStyle="bold" android:text="00:00" />
        <SeekBar android:id="@+id/player_seek" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:max="1000" android:splitTrack="false" android:contentDescription="@string/player_seek_description" />
        <com.google.android.material.textview.MaterialTextView android:id="@+id/player_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/enhancement_progress_secondary" android:textSize="13sp" android:textStyle="bold" android:text="00:00" />
    </LinearLayout>
</merge>