<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <ImageView android:layout_width="88dp" android:layout_height="88dp" android:layout_gravity="center" android:layout_marginTop="24dp" android:src="@drawable/ic_preview_check" android:importantForAccessibility="no" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="@string/h7_file_saved" android:textColor="@color/preview_text" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/h7_saved_description" android:textColor="@color/preview_secondary" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/bg_preview_card">
        <TextView android:id="@+id/success_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/preview_text" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/success_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:background="@drawable/bg_enhancement_result_mode" android:textColor="@color/enhancement_result_teal_dark" android:textSize="13sp" android:textStyle="bold" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="@color/preview_border" />
        <TextView android:id="@+id/success_duration" style="@style/Widget.Soundly.H7.Info" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/success_format" style="@style/Widget.Soundly.H7.Info" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/success_size" style="@style/Widget.Soundly.H7.Info" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/success_uri" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:text="@string/h7_open_file" android:textColor="@color/preview_primary" android:textSize="13sp" android:focusable="true" android:clickable="true" />
    </LinearLayout>
    <include layout="@layout/view_h7_retained" />
    <TextView android:id="@+id/success_error" android:accessibilityLiveRegion="polite" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="?attr/colorError" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/success_share" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="18dp" android:insetTop="0dp" android:insetBottom="0dp" android:background="@drawable/bg_preview_primary" app:backgroundTint="@null" android:text="@string/h7_share" android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/success_share_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/preview_secondary" android:textSize="12sp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/success_library" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/h7_back_library" android:textColor="@color/preview_primary" app:strokeColor="@color/preview_primary" app:cornerRadius="25dp" />
</LinearLayout>
