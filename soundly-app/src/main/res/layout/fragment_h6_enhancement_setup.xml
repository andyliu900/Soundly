<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/preview_background">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="16dp">
            <ProgressBar android:id="@+id/setup_loading" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" />
            <TextView android:id="@+id/setup_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/h6_source_missing" android:textColor="@color/preview_text" android:visibility="gone" />
            <LinearLayout android:id="@+id/setup_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:padding="14dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_preview_card">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/setup_source_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="@color/preview_text" android:textSize="18sp" android:textStyle="bold" android:includeFontPadding="false" app:lineHeight="23sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:id="@+id/setup_source_scene" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="22dp" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:background="@drawable/bg_preview_pill" android:textColor="@color/preview_primary" android:textSize="12sp" android:textStyle="bold" android:drawablePadding="4dp" app:drawableStartCompat="@drawable/ic_enhancement_scene" app:drawableTint="@color/preview_primary" />
                            <TextView android:id="@+id/setup_source_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/preview_secondary" android:textSize="12sp" android:drawablePadding="5dp" app:drawableStartCompat="@drawable/ic_enhancement_clock" app:drawableTint="@color/preview_secondary" />
                        </LinearLayout>
                    </LinearLayout>
                    <FrameLayout android:layout_width="60dp" android:layout_height="48dp" android:layout_marginStart="6dp">
                        <com.ideacode.soundly.common.ui.audio.WaveformView android:id="@+id/setup_waveform" android:layout_width="match_parent" android:layout_height="match_parent" />
                        <ImageView android:id="@+id/setup_waveform_placeholder" android:layout_width="match_parent" android:layout_height="32dp" android:layout_gravity="center" android:src="@drawable/ic_enhancement_audio" android:importantForAccessibility="no" />
                        <SeekBar android:id="@+id/setup_seek" android:layout_width="match_parent" android:layout_height="match_parent" android:max="1000" android:padding="0dp" android:progressDrawable="@android:color/transparent" android:thumb="@android:color/transparent" android:background="?attr/selectableItemBackground" android:contentDescription="@string/player_seek_description" />
                    </FrameLayout>
                    <ImageButton android:id="@+id/setup_play" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:padding="12dp" android:background="@drawable/bg_setup_play" android:src="@drawable/ic_h4_play" app:tint="@color/preview_primary" android:contentDescription="@string/preview_play" />
                </LinearLayout>
                <TextView android:id="@+id/setup_waveform_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/setup_waveform_unavailable" android:textColor="@color/preview_secondary" android:textSize="12sp" android:visibility="gone" />
                <TextView android:id="@+id/setup_playback_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/error_playback_failed" android:textColor="?attr/colorError" android:textSize="12sp" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:minHeight="84dp" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_preview_tint">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_enhancement_sparkle" app:tint="@color/preview_primary" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:id="@+id/setup_recommended" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_recommendation" android:textColor="@color/preview_primary" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false" app:lineHeight="20sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/setup_recommendation_detail" android:textColor="@color/preview_secondary" android:textSize="12sp" app:lineHeight="19sp" android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/setup_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="22dp" android:text="@string/h6_choose" android:textColor="@color/preview_text" android:textSize="18sp" android:textStyle="bold" android:includeFontPadding="false" app:lineHeight="24sp" />
                <RadioGroup android:id="@+id/setup_modes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/setup_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_shield" app:tint="@color/preview_secondary" android:importantForAccessibility="no" />
            <TextView android:id="@+id/setup_local" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/h6_local" android:textColor="@color/preview_secondary" android:textSize="12sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/enhancement_start" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:insetTop="0dp" android:insetBottom="0dp" android:background="@drawable/bg_preview_primary" app:backgroundTint="@null" android:text="@string/enhancement_start" android:textColor="@color/preview_button_text" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
