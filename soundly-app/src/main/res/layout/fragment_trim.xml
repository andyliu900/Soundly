<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trim_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/preview_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingBottom="20dp">
        <ProgressBar android:id="@+id/trim_loading" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" />
        <TextView android:id="@+id/trim_missing" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:gravity="center" android:text="@string/h5_missing" android:textColor="?attr/colorError" android:visibility="gone" />
        <LinearLayout android:id="@+id/trim_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="72dp" android:background="@drawable/bg_preview_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/trim_project" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/preview_text" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/trim_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/preview_secondary" android:textSize="13sp" />
                </LinearLayout>
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_preview_pill" android:padding="12dp" android:src="@drawable/ic_soundly_wave" app:tint="@color/preview_primary" android:importantForAccessibility="no" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/i3_select_title" android:textColor="@color/preview_text" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/i3_select_hint" android:textColor="@color/preview_secondary" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_preview_card" android:orientation="vertical" android:padding="12dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="132dp">
                    <com.ideacode.soundly.common.ui.audio.WaveformView android:id="@+id/trim_waveform" android:layout_width="match_parent" android:layout_height="72dp" android:layout_gravity="center" android:layout_marginHorizontal="22dp" />
                    <com.ideacode.soundly.feature.editing.TrimRangeOverlay android:id="@+id/trim_range_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
                    <com.google.android.material.slider.RangeSlider android:id="@+id/trim_range" android:layout_width="match_parent" android:layout_height="48dp" android:layout_gravity="center_vertical" android:valueFrom="0" android:valueTo="10000" android:contentDescription="@string/i3_range_description" app:trackColorActive="@android:color/transparent" app:trackColorInactive="@android:color/transparent" app:thumbColor="@android:color/transparent" app:thumbElevation="0dp" app:haloColor="@color/preview_primary" />
                </FrameLayout>
                <TextView android:id="@+id/trim_wave_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:textColor="@color/preview_secondary" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00" android:textColor="@color/preview_secondary" />
                    <TextView android:id="@+id/trim_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/preview_secondary" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/trim_start" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/bg_preview_card" app:backgroundTint="@null" android:textColor="@color/preview_text" android:minHeight="64dp" app:icon="@drawable/ic_h4_marker" app:iconTint="@color/preview_primary" app:iconSize="22dp" app:iconGravity="textStart" />
                <com.google.android.material.button.MaterialButton android:id="@+id/trim_end" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/bg_preview_card" app:backgroundTint="@null" android:textColor="@color/preview_text" android:minHeight="64dp" app:icon="@drawable/ic_trim_flag" app:iconTint="@color/preview_primary" app:iconSize="22dp" app:iconGravity="textStart" />
            </LinearLayout>
            <TextView android:id="@+id/trim_retained" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="12dp" android:background="@drawable/bg_preview_pill" android:paddingHorizontal="18dp" android:paddingVertical="8dp" android:textColor="@color/preview_primary" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/trim_play" style="@style/Widget.Material3.Button.IconButton.Filled" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center" android:layout_marginTop="14dp" android:contentDescription="@string/i3_preview" app:backgroundTint="@color/preview_control" app:icon="@drawable/ic_h4_play" app:iconSize="28dp" app:iconGravity="textStart" app:iconPadding="0dp" app:iconTint="@color/white" app:cornerRadius="32dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="@string/i3_preview" android:textColor="@color/preview_secondary" />
            <TextView android:id="@+id/trim_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="?attr/colorError" android:visibility="gone" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="@string/i3_keep_original" android:textColor="@color/preview_secondary" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/trim_apply" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:insetTop="0dp" android:insetBottom="0dp" android:background="@drawable/bg_preview_primary" app:backgroundTint="@null" android:text="@string/trim_apply" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/trim_cancel" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/cancel" android:textColor="@color/preview_primary" app:strokeColor="@color/preview_primary" app:cornerRadius="26dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
