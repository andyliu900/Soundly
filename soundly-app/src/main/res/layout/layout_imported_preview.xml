<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="10dp" android:paddingBottom="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:background="@drawable/bg_imported_success" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_preview_check" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/imported_saved_title" android:textColor="@color/preview_text" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/imported_saved_detail" android:textColor="@color/preview_secondary" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_preview_card" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/imported_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="190dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/preview_text" android:textSize="20sp" android:textStyle="bold" />
            <ImageButton android:id="@+id/imported_rename" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/preview_rename" android:padding="14dp" android:src="@drawable/ic_h5_edit" app:tint="@color/preview_secondary" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_preview_pill" android:paddingHorizontal="10dp" android:paddingVertical="3dp" android:text="@string/imported_badge" android:textColor="@color/preview_primary" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/imported_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/preview_secondary" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:id="@+id/imported_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/preview_secondary" android:textSize="14sp" app:drawableStartCompat="@drawable/ic_preview_file" app:drawableTint="@color/preview_secondary" android:drawablePadding="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/imported_format" style="@style/Widget.Soundly.Preview.Metadata" android:layout_width="wrap_content" android:layout_height="wrap_content" app:drawableStartCompat="@drawable/ic_preview_file" />
            <View android:layout_width="1dp" android:layout_height="16dp" android:layout_marginHorizontal="9dp" android:background="@color/preview_track" />
            <TextView android:id="@+id/imported_duration" style="@style/Widget.Soundly.Preview.Metadata" android:layout_width="wrap_content" android:layout_height="wrap_content" app:drawableStartCompat="@drawable/ic_enhancement_clock" />
            <View android:layout_width="1dp" android:layout_height="16dp" android:layout_marginHorizontal="9dp" android:background="@color/preview_track" />
            <TextView android:id="@+id/imported_size" style="@style/Widget.Soundly.Preview.Metadata" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" app:drawableStartCompat="@drawable/ic_preview_file" />
        </LinearLayout>
        <com.ideacode.soundly.common.ui.audio.WaveformView android:id="@+id/imported_waveform" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="12dp" />
        <TextView android:id="@+id/imported_wave_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:textColor="@color/preview_secondary" android:textSize="13sp" android:visibility="gone" />
        <TextView android:id="@+id/imported_playback_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/error_playback_failed" android:textColor="?attr/colorError" android:visibility="gone" />
        <com.ideacode.soundly.common.ui.audio.AudioPlayerView android:id="@+id/imported_player" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:audioPlayerPreview="true" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_preview_tint" android:gravity="center_vertical" android:orientation="horizontal" android:padding="15dp">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_preview_file" android:importantForAccessibility="no" app:tint="@color/preview_primary" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/imported_version_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/preview_text" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/imported_version_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/preview_secondary" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_preview_tint" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_enhancement_sparkle" android:importantForAccessibility="no" app:tint="@color/preview_primary" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/imported_recommend_title" android:textColor="@color/preview_primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/imported_recommend_detail" android:textColor="@color/preview_secondary" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/imported_enhance" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="24dp" android:insetTop="0dp" android:insetBottom="0dp" android:background="@drawable/bg_preview_primary" app:backgroundTint="@null" android:text="@string/imported_enhance" android:textColor="@color/preview_button_text" android:textSize="16sp" android:textStyle="bold" app:icon="@drawable/ic_enhancement_sparkle" app:iconGravity="textStart" app:iconTint="@color/white" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/imported_trim" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/imported_trim" android:textColor="@color/preview_primary" app:icon="@drawable/ic_imported_trim" app:iconSize="20dp" app:iconGravity="textStart" app:iconTint="@color/preview_primary" app:strokeColor="@color/preview_primary" app:cornerRadius="26dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/imported_export" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/imported_export" android:textColor="@color/preview_primary" app:icon="@drawable/ic_enhancement_result_share" app:iconSize="20dp" app:iconGravity="textStart" app:iconTint="@color/preview_primary" app:strokeColor="@color/preview_primary" app:cornerRadius="26dp" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/imported_library" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/imported_library" android:textColor="@color/preview_secondary" />
</LinearLayout>
