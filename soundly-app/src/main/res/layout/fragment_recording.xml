<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp">
    <com.google.android.material.textview.MaterialTextView android:id="@+id/recording_status" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/recording_idle" android:textAppearance="?attr/textAppearanceTitleLarge" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
