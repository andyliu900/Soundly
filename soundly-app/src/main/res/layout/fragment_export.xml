<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/export_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/preview_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingTop="8dp" android:paddingBottom="@dimen/h7_scroll_bottom_padding">
        <ProgressBar android:id="@+id/export_loading" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" />
        <TextView android:id="@+id/export_missing" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/h6_source_missing" android:textColor="@color/preview_text" android:padding="16dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/export_config" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:padding="14dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_enhancement_result_success">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_preview_check" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/h7_source_saved" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/preview_text" />
                    <TextView android:id="@+id/export_original_kept" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/h7_original_kept" android:textSize="13sp" android:textColor="@color/preview_secondary" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/export_project_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/preview_text" android:textSize="23sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/export_scene" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="25dp" android:paddingHorizontal="10dp" android:gravity="center_vertical" android:background="@drawable/bg_preview_pill" android:textColor="@color/preview_primary" android:textStyle="bold" android:textSize="12sp" android:drawablePadding="5dp" app:drawableStartCompat="@drawable/ic_enhancement_scene" app:drawableTint="@color/preview_primary" />
                <TextView android:id="@+id/export_source_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="25dp" android:layout_marginStart="8dp" android:paddingHorizontal="10dp" android:gravity="center_vertical" android:background="@drawable/bg_enhancement_result_mode" android:textColor="@color/enhancement_result_teal_dark" android:textStyle="bold" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/bg_preview_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/h7_settings" android:textColor="@color/preview_text" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/h7_filename" android:labelFor="@id/export_name" android:textColor="@color/preview_secondary" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_preview_pill" android:paddingHorizontal="12dp">
                    <EditText android:id="@+id/export_name" android:importantForAutofill="no" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@android:color/transparent" android:singleLine="true" android:maxLength="101" android:inputType="textCapSentences" android:hint="@string/h7_filename_hint" android:textColor="@color/preview_text" android:textColorHint="@color/preview_secondary" android:textSize="16sp" />
                    <TextView android:id="@+id/export_extension" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/preview_secondary" android:textStyle="bold" android:textSize="15sp" />
                </LinearLayout>
                <TextView android:id="@+id/export_name_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/h7_filename_help" android:textColor="@color/preview_secondary" android:textSize="12sp" />
                <TextView android:id="@+id/export_name_error" android:accessibilityLiveRegion="polite" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/h7_filename_error" android:textColor="?attr/colorError" android:visibility="gone" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="10dp" android:background="@color/preview_border" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/h7_format" android:textColor="@color/preview_text" android:textSize="15sp" android:textStyle="bold" />
                <RadioGroup android:id="@+id/export_formats" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
                <TextView android:id="@+id/export_format_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/preview_secondary" android:textSize="12sp" android:visibility="gone" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="@color/preview_border" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/h7_destination" android:textColor="@color/preview_text" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/h7_download_folder" android:textColor="@color/preview_secondary" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <include layout="@layout/view_h7_retained" />
            <ProgressBar android:id="@+id/export_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp" android:max="100" android:visibility="gone" />
            <TextView android:id="@+id/export_progress_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/preview_secondary" android:visibility="gone" />
            <TextView android:id="@+id/export_error" android:accessibilityLiveRegion="polite" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="?attr/colorError" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/export_open_downloads" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/h7_open_downloads" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/export_permission_settings" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/h7_permission_settings" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/export_downloads" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="18dp" android:insetTop="0dp" android:insetBottom="0dp" android:background="@drawable/bg_preview_primary" app:backgroundTint="@null" android:text="@string/h7_save" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/export_share" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/h7_share" android:textColor="@color/preview_primary" app:strokeColor="@color/preview_primary" app:cornerRadius="25dp" android:textSize="16sp" />
            <TextView android:id="@+id/export_share_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/preview_secondary" android:textSize="12sp" />
        </LinearLayout>
        <include android:id="@+id/export_success_content" layout="@layout/layout_export_success" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
