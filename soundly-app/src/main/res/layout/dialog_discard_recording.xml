<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="20dp">
        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_s1_warning_circle" android:src="@drawable/ic_microphone" android:padding="20dp" app:tint="#FF6B6B" android:importantForAccessibility="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="@string/h4_discard_title" android:textColor="@color/preview_text" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/s1_discard_description" android:textColor="@color/preview_secondary" android:textSize="15sp" />
        <TextView android:id="@+id/discard_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="12dp" android:gravity="center" android:background="@drawable/bg_preview_pill" android:textColor="@color/preview_primary" android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/discard_return" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:insetTop="0dp" android:insetBottom="0dp" android:background="@drawable/bg_preview_primary" app:backgroundTint="@null" android:text="@string/h4_continue_recording" android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/discard_confirm" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/h4_discard_confirm" android:textColor="#FF6B6B" android:textSize="17sp" app:strokeColor="#FF6B6B" app:cornerRadius="26dp" />
    </LinearLayout>
</ScrollView>
