<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/enhancement_progress_background" android:theme="@style/Theme.Soundly.EnhancementProgress" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="0dp" android:paddingBottom="24dp" android:orientation="vertical">
        <ProgressBar android:id="@+id/result_loading" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" />
        <TextView android:id="@+id/result_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/h6_source_missing" android:textColor="@color/enhancement_progress_text" android:visibility="gone"  android:includeFontPadding="false"  android:fallbackLineSpacing="false" />
        <LinearLayout android:id="@+id/result_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_enhancement_result_success">
                <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_enhancement_result_check" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:id="@+id/result_saved" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/h6_saved" android:textColor="@color/enhancement_progress_text" android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"  android:fallbackLineSpacing="false"  app:lineHeight="20sp" />
                    <TextView android:id="@+id/result_saved_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/enhancement_result_original_kept" android:textColor="@color/enhancement_progress_secondary" android:textSize="14sp" android:includeFontPadding="false"  android:fallbackLineSpacing="false"  app:lineHeight="18sp" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/result_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginStart="4dp" android:textColor="@color/enhancement_progress_text" android:textSize="24sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"  android:includeFontPadding="false"  android:fallbackLineSpacing="false"  app:lineHeight="30sp" />
            <TextView android:id="@+id/result_scene" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginTop="4dp" android:layout_marginStart="4dp" android:paddingHorizontal="12dp" android:gravity="center_vertical" android:background="@drawable/bg_enhancement_progress_scene" android:textColor="@color/enhancement_progress_primary" android:textSize="14sp" android:textStyle="bold" app:drawableStartCompat="@drawable/ic_enhancement_scene" android:drawablePadding="6dp"  android:includeFontPadding="false"  android:fallbackLineSpacing="false"  app:lineHeight="18sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:orientation="vertical" android:background="@drawable/bg_enhancement_progress_card">
                <TextView android:id="@+id/result_compare" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/h6_compare" android:textColor="@color/enhancement_progress_text" android:textSize="18sp" android:textStyle="bold" android:includeFontPadding="false"  android:fallbackLineSpacing="false"  app:lineHeight="22sp" />
                <RadioGroup android:id="@+id/version_toggle" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:background="@drawable/bg_enhancement_progress_scene">
                    <androidx.appcompat.widget.AppCompatRadioButton android:id="@+id/version_original" style="@style/Widget.Soundly.EnhancementResult.Tab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/enhancement_result_original" android:background="@drawable/bg_enhancement_result_original_tab" />
                    <androidx.appcompat.widget.AppCompatRadioButton android:id="@+id/version_enhanced" style="@style/Widget.Soundly.EnhancementResult.Tab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/enhancement_result_enhanced" android:background="@drawable/bg_enhancement_result_enhanced_tab" />
                </RadioGroup>
                <com.ideacode.soundly.common.ui.audio.WaveformView android:id="@+id/result_waveform" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/result_waveform_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/h5_waveform_unavailable" android:textColor="@color/enhancement_progress_secondary" android:textSize="13sp" android:visibility="gone"  android:includeFontPadding="false"  android:fallbackLineSpacing="false" />
                <TextView android:id="@+id/result_playback_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/error_playback_failed" android:textColor="?attr/colorError" android:visibility="gone"  android:includeFontPadding="false"  android:fallbackLineSpacing="false" />
                <com.ideacode.soundly.common.ui.audio.AudioPlayerView android:id="@+id/result_player" android:layout_width="match_parent" android:layout_height="wrap_content" app:audioPlayerCompact="true" />
            </LinearLayout>
            <TextView android:id="@+id/result_effect" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginStart="4dp" android:text="@string/h6_effect" android:textColor="@color/enhancement_progress_text" android:textSize="18sp" android:textStyle="bold"  android:includeFontPadding="false"  android:fallbackLineSpacing="false"  app:lineHeight="22sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/bg_enhancement_progress_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="30dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/enhancement_result_mode" android:textColor="@color/enhancement_progress_secondary" android:textSize="16sp" android:textStyle="bold"  android:includeFontPadding="false"  android:fallbackLineSpacing="false"  app:lineHeight="20sp" />
                    <TextView android:id="@+id/enhancement_result_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="30dp" android:paddingHorizontal="14dp" android:paddingVertical="4dp" android:gravity="center" android:background="@drawable/bg_enhancement_result_mode" android:textColor="@color/enhancement_result_teal_dark" android:textSize="16sp" android:textStyle="bold"  android:includeFontPadding="false"  android:fallbackLineSpacing="false"  app:lineHeight="20sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginBottom="6dp" android:background="@color/enhancement_progress_track" />
                <TextView android:id="@+id/result_effect_one" style="@style/Widget.Soundly.EnhancementResult.Effect" android:layout_width="match_parent" android:layout_height="wrap_content"  android:includeFontPadding="false"  android:fallbackLineSpacing="false" />
                <TextView android:id="@+id/result_effect_two" style="@style/Widget.Soundly.EnhancementResult.Effect" android:layout_width="match_parent" android:layout_height="wrap_content"  android:includeFontPadding="false"  android:fallbackLineSpacing="false" />
                <TextView android:id="@+id/result_effect_three" style="@style/Widget.Soundly.EnhancementResult.Effect" android:layout_width="match_parent" android:layout_height="wrap_content"  android:includeFontPadding="false"  android:fallbackLineSpacing="false" />
            </LinearLayout>
            <TextView android:id="@+id/result_selected_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_marginTop="10dp" android:paddingStart="8dp" android:gravity="center_vertical" android:textColor="@color/enhancement_progress_secondary" android:textSize="15sp" android:textStyle="bold" app:drawableStartCompat="@drawable/ic_enhancement_result_file" android:drawablePadding="12dp"  android:includeFontPadding="false"  android:fallbackLineSpacing="false"  app:lineHeight="20sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/enhancement_result_export" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/preview_export" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/white" app:backgroundTint="@null" android:background="@drawable/bg_enhancement_result_primary" app:icon="@drawable/ic_enhancement_result_share" app:iconTint="@color/white" app:iconSize="24dp" app:iconPadding="16dp" app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton android:id="@+id/result_new_version" style="@style/Widget.Soundly.EnhancementProgress.OutlineButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp" android:text="@string/h6_new_version" android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
