<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView android:id="@+id/preview_root" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/preview_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="8dp">
        <ProgressBar android:id="@+id/preview_loading" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" />
        <TextView android:id="@+id/preview_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="@string/h5_missing" android:textColor="?attr/colorError" android:visibility="gone" />
        <LinearLayout android:id="@+id/preview_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp" android:paddingVertical="10dp">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_preview_check" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView android:id="@+id/preview_saved" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/preview_original_saved" android:textColor="@color/preview_text" android:textSize="17sp" android:textStyle="bold" android:includeFontPadding="false" app:lineHeight="21sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/h5_saved_description" android:textColor="@color/preview_secondary" android:textSize="13sp" android:includeFontPadding="false" app:lineHeight="18sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/bg_preview_card" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="8dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/preview_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:maxLines="2" android:ellipsize="end" android:textColor="@color/preview_text" android:textSize="18sp" android:textStyle="bold" android:includeFontPadding="false" app:lineHeight="23sp" />
                    <ImageButton android:id="@+id/preview_rename" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/preview_rename" android:src="@drawable/ic_h5_edit" android:padding="14dp" app:tint="@color/preview_secondary" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/preview_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/preview_secondary" android:textSize="13sp" android:includeFontPadding="false" />
                    <TextView android:id="@+id/preview_scene" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="24dp" android:layout_marginStart="10dp" android:background="@drawable/bg_preview_pill" android:paddingHorizontal="8dp" android:gravity="center_vertical" android:textColor="@color/preview_primary" android:textSize="12sp" android:textStyle="bold" android:drawablePadding="4dp" app:drawableStartCompat="@drawable/ic_enhancement_scene" app:drawableTint="@color/preview_primary" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/preview_format" style="@style/Widget.Soundly.Preview.Metadata" android:layout_width="wrap_content" android:layout_height="wrap_content" app:drawableStartCompat="@drawable/ic_preview_file" />
                    <View android:layout_width="1dp" android:layout_height="16dp" android:layout_marginHorizontal="10dp" android:background="@color/preview_track" />
                    <TextView android:id="@+id/preview_duration" style="@style/Widget.Soundly.Preview.Metadata" android:layout_width="wrap_content" android:layout_height="wrap_content" app:drawableStartCompat="@drawable/ic_enhancement_clock" />
                    <View android:layout_width="1dp" android:layout_height="16dp" android:layout_marginHorizontal="10dp" android:background="@color/preview_track" />
                    <TextView android:id="@+id/preview_size" style="@style/Widget.Soundly.Preview.Metadata" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" app:drawableStartCompat="@drawable/ic_preview_file" />
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="92dp" android:layout_marginTop="8dp">
                    <com.ideacode.soundly.common.ui.audio.WaveformView android:id="@+id/preview_waveform" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="4dp" />
                    <com.ideacode.soundly.feature.preview.MarkerTimelineView android:id="@+id/preview_timeline" android:layout_width="match_parent" android:layout_height="match_parent" />
                </FrameLayout>
                <TextView android:id="@+id/preview_waveform_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/h5_waveform_unavailable" android:textColor="@color/preview_secondary" android:textSize="13sp" android:visibility="gone" />
                <TextView android:id="@+id/preview_playback_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/error_playback_failed" android:textColor="?attr/colorError" android:visibility="gone" />
                <com.ideacode.soundly.common.ui.audio.AudioPlayerView android:id="@+id/preview_player" android:layout_width="match_parent" android:layout_height="wrap_content" app:audioPlayerPreview="true" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="12dp" android:text="@string/h5_markers" android:textColor="@color/preview_text" android:textSize="18sp" android:textStyle="bold" android:includeFontPadding="false" app:lineHeight="24sp" />
            <LinearLayout android:id="@+id/preview_markers" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_preview_markers" android:orientation="vertical" android:paddingHorizontal="14dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="65dp" android:background="@drawable/bg_preview_tint" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_enhancement_sparkle" app:tint="@color/preview_primary" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/preview_recommend_title" android:textColor="@color/preview_primary" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false" app:lineHeight="20sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/preview_recommend_detail" android:textColor="@color/preview_secondary" android:textSize="12sp" android:includeFontPadding="false" app:lineHeight="18sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:orientation="horizontal">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_shield" app:tint="@color/preview_secondary" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/h5_local" android:textColor="@color/preview_secondary" android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/preview_enhance" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:insetTop="0dp" android:insetBottom="0dp" android:background="@drawable/bg_preview_primary" app:backgroundTint="@null" android:text="@string/h5_enhance_now" android:textColor="@color/preview_button_text" android:textSize="16sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/preview_adjust" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/h5_adjust" android:textColor="@color/preview_primary" android:textSize="16sp" android:textStyle="bold" app:strokeColor="@color/preview_primary" app:cornerRadius="24dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/preview_skip" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:text="@string/h5_skip" android:textColor="@color/preview_secondary" android:textSize="14sp" />
        </LinearLayout>
        <ViewStub android:id="@+id/imported_preview_stub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout="@layout/layout_imported_preview" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
