<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:gravity="center_horizontal" android:orientation="vertical">
  <ImageView android:layout_width="68dp" android:layout_height="68dp" android:padding="18dp" android:background="@drawable/bg_icon_circle" android:src="@drawable/ic_enhancement_sparkle" app:tint="@color/enhancement_progress_primary" android:importantForAccessibility="no" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/enhancement_cancel_title" android:gravity="center" android:textColor="@color/enhancement_progress_text" android:textStyle="bold" android:textSize="21sp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/enhancement_cancel_message" android:gravity="center" android:textColor="@color/enhancement_progress_secondary" />
  <TextView android:id="@+id/cancel_progress_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="14dp" android:background="@drawable/bg_enhancement_progress_badge" android:textColor="@color/enhancement_progress_primary" />
  <com.google.android.material.button.MaterialButton android:id="@+id/cancel_continue" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:text="@string/h6_continue" android:background="@drawable/bg_preview_primary" app:backgroundTint="@null" android:textColor="@color/white" />
  <com.google.android.material.button.MaterialButton android:id="@+id/cancel_confirm" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/enhancement_cancel" android:textColor="#FF6B6B" app:strokeColor="#FF6B6B" app:cornerRadius="26dp" />
 </LinearLayout>
</ScrollView>
