<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/preview_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/project_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/preview_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/project_rename"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/preview_rename"
                android:src="@drawable/ic_h5_edit"
                app:tint="@color/preview_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/project_metadata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/preview_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/project_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/preview_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_preview_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/s2_listening"
                    android:textColor="@color/preview_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/project_current_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_library_search"
                    android:backgroundTint="@color/imported_success_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/library_badge_enhanced_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.ideacode.soundly.common.ui.audio.WaveformView
                android:id="@+id/project_waveform"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/project_wave_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/imported_wave_retry"
                android:visibility="gone" />

            <com.ideacode.soundly.common.ui.audio.AudioPlayerView
                android:id="@+id/project_player"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:audioPlayerDetail="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/project_versions_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/detail_versions"
            android:textColor="@color/preview_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/project_versions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_preview_card"
            android:clipToOutline="true"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/project_markers_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/project_markers"
                android:textColor="@color/preview_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/project_marker_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/preview_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/project_markers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_preview_card"
            android:orientation="vertical"
            android:paddingHorizontal="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/project_trim"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/preview_trim"
                android:textColor="@color/preview_primary"
                app:icon="@drawable/ic_imported_trim"
                app:iconGravity="textStart"
                app:iconTint="@color/preview_primary"
                app:strokeColor="@color/preview_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/project_enhance"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/s2_enhance"
                android:textColor="@color/preview_primary"
                app:icon="@drawable/ic_enhancement_sparkle"
                app:iconGravity="textStart"
                app:iconTint="@color/preview_primary"
                app:strokeColor="@color/preview_primary" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/project_export"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_preview_primary"
            android:text="@string/preview_export"
            android:textColor="@color/white"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>